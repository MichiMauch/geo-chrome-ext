{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "chrome",
      "node"
    ],
    "noEmit": true,
    "rootDir": "."
  },
  "include": [
    "src/**/*",
    "e2e/**/*",
    "playwright.config.ts",
    "cli/**/*",
    "vite.cli.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
