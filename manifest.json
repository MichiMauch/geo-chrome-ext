{
  "manifest_version": 3,
  "name": "Paul AI GEO Analyzer",
  "version": "3.0.2",
  "description": "Analyzes web pages for Generative Engine Optimization (GEO) with score tracking, trend analysis and history - by NETNODE",
  "permissions": ["activeTab", "scripting", "storage", "alarms", "sidePanel", "tabs"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
